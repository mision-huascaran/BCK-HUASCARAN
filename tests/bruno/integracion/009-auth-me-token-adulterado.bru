meta {
  name: AUTH me · token adulterado
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdulterado}}
}

script:pre-request {
  bru.setVar('tokenAdulterado', bru.getVar('tokenSupervisor').slice(0, -4) + 'AAAA');
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}

docs {
  CU003: el servidor rechaza un token con la firma alterada.
}
