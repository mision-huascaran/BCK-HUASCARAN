meta {
  name: ASI registrar · fecha futura
  type: http
  seq: 150
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "fecha": "{{fechaFutura}}",
    "registros": [{ "id_alumno": {{idAlumnoInt}}, "estado": "presente" }]
  }
}

script:pre-request {
  bru.setVar('fechaFutura', new Date(Date.now() - 5 * 3600e3 + 7 * 86400e3).toISOString().slice(0, 10));
}

tests {
  test("422 fecha_no_lectiva", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('fecha_no_lectiva');
  });
}
