meta {
  name: SES iniciar actividad · sin token
  type: http
  seq: 98
}

post {
  url: {{baseUrl}}/actividades
  body: json
  auth: none
}

body:json {
  {
    "id_actividad": "{{idActividadInt}}"
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
