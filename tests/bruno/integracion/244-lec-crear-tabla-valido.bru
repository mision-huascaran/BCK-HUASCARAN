meta {
  name: LEC crear tabla · válido
  type: http
  seq: 244
}

post {
  url: {{baseUrl}}/lectura/tablas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "id_operacion": "{{opTabla}}",
    "id_colegio": {{idColegioDoc}},
    "id_programa": {{idPrograma1}},
    "id_grado": {{idGradoClase}},
    "id_seccion": {{idSeccion}},
    "id_anio_escolar": {{idAnio}},
    "mes": {{mesClase}},
    "id_semana": {{idSemana}}
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  bru.setVar('opTabla', uuid());
}

script:post-response {
  bru.setVar('idTabla', res.body.id);
  bru.setVar('versionTabla', res.body.version);
  bru.setVar('versionFila', res.body.filas[0].version);
}

tests {
  test("201 con la fila del alumno", function () { expect(res.status).to.equal(201); expect(res.body.filas[0].id_alumno).to.equal(Number(bru.getVar("idAlumnoInt"))); });
}
