meta {
  name: SES seguimiento docentes · válido
  type: http
  seq: 167
}

get {
  url: {{baseUrl}}/seguimiento/docentes
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("docentes con su sincronización", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.every((d) => ['al_dia', 'pendiente'].includes(d.sincronizacion))).to.equal(true);
  });
}
