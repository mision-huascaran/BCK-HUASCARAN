meta {
  name: ALU colegio del Docente
  type: http
  seq: 102
}

get {
  url: {{baseUrl}}/colegios/{{idColegioDoc}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

script:post-response {
  bru.setVar('idProgramaDoc', res.body.programas[0].id);
  const propios = JSON.parse(bru.getVar('gradosDoc'));
  const ajeno = res.body.grados.find((g) => !propios.includes(g.id));
  bru.setVar('idGradoAjeno', ajeno ? ajeno.id : null);
}

tests {
  test("200", function () { expect(res.status).to.equal(200); });
}

docs {
  # Alumnos (CU014, CU015)

  Supervisor: todos los alumnos, sin actividad. Docente: solo sus aulas y con una
  actividad iniciada para escribir. Directivo: sin acceso.
}
