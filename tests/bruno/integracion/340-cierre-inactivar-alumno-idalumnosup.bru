meta {
  name: CIERRE inactivar alumno (idAlumnoSup)
  type: http
  seq: 340
}

patch {
  url: {{baseUrl}}/alumnos/{{idAlumnoSup}}/desactivar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "aplicar_desde": "{{hoy}}"
  }
}

tests {
  test("inactivo (o la clase de hoy ya lo tiene en su lista congelada)", function () {
    expect([200, 409]).to.include(res.status);
    if (res.status === 200) expect(res.body.activo).to.equal(false);
  });
}
