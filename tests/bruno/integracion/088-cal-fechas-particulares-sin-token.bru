meta {
  name: CAL fechas particulares · sin token
  type: http
  seq: 88
}

post {
  url: {{baseUrl}}/calendarios/particulares
  body: json
  auth: none
}

body:json {
  {
    "id_colegio": {{idColegioInt}},
    "id_anio_escolar": {{idAnio}},
    "periodos": {{periodosGeneral}}
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
