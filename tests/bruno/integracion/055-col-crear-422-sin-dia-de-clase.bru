meta {
  name: COL crear · 422 sin día de clase
  type: http
  seq: 55
}

post {
  url: {{baseUrl}}/colegios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombre": "I.E. Bruno inválido",
    "departamento": "Áncash",
    "provincia": "Huaraz",
    "grados": [{{idGrado1}}, {{idGrado2}}],
    "programas": {{idProgramas}}
  }
}

tests {
  test("422 sin día de clase", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('grados');
  });
}
