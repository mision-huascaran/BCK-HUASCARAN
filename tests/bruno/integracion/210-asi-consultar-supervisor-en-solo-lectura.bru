meta {
  name: ASI consultar · Supervisor en solo lectura
  type: http
  seq: 210
}

get {
  url: {{baseUrl}}/asistencias?id_colegio={{idColegioDoc}}&id_grado={{idGradoClase}}&id_seccion={{idSeccion}}&fecha={{fechaClase}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("no se puede escribir", function () { expect(res.status).to.equal(200); expect(res.body.escritura.permitida).to.equal(false); });
}
