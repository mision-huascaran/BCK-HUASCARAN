meta {
  name: RUB evaluar · válido
  type: http
  seq: 271
}

put {
  url: {{baseUrl}}/rubricas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  []
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  req.setBody([{ id_operacion: uuid(), version: null, id_alumno: Number(bru.getVar('idAlumnoInt')), id_colegio: Number(bru.getVar('idColegioDoc')), id_grado: Number(bru.getVar('idGradoClase')), id_seccion: Number(bru.getVar('idSeccion')), id_programa: Number(bru.getVar('idPrograma1')), id_anio_escolar: Number(bru.getVar('idAnio')), mes: Number(bru.getVar('mesHoy')), fluidez: 2, comprension: 3 }]);
}

script:post-response {
  bru.setVar('versionRubrica', res.body[0].registro ? res.body[0].registro.version : null);
}

tests {
  test("completada con resultado 4·F + 6·C = 26 décimas", function () {
    expect(res.status).to.equal(200);
    expect(res.body[0].estado).to.equal('aceptada');
    expect(res.body[0].registro.estado).to.equal('completada');
    expect(res.body[0].registro.resultado_decimas).to.equal(26);
  });
}
