meta {
  name: PER detalle · Directivo sin permiso
  type: http
  seq: 147
}

get {
  url: {{baseUrl}}/usuarios/{{idUsuarioInt}}/permisos/{{idPermiso}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
