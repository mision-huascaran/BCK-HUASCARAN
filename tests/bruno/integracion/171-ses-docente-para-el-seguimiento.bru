meta {
  name: SES docente para el seguimiento
  type: http
  seq: 171
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

script:post-response {
  bru.setVar('idDocente', res.body.id_docente);
}

tests {
  test("200", function () { expect(res.status).to.equal(200); });
}
