meta {
  name: CAL crear general · Docente sin permiso
  type: http
  seq: 84
}

post {
  url: {{baseUrl}}/calendarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "id_anio_escolar": {{idAnio}},
    "periodos": {{periodosGeneral}}
  }
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
