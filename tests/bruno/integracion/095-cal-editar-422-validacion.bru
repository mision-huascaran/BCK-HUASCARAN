meta {
  name: CAL editar · 422 validacion
  type: http
  seq: 95
}

put {
  url: {{baseUrl}}/calendarios/{{idCalendarioPart}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "periodos": {{periodosGeneral}}
  }
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('version');
  });
}
