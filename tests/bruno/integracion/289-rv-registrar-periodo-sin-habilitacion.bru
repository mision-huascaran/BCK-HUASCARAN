meta {
  name: RV registrar · periodo sin habilitación
  type: http
  seq: 289
}

put {
  url: {{baseUrl}}/registro-vuelo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  []
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  req.setBody([{ id_operacion: uuid(), version: null, id_alumno: Number(bru.getVar('idAlumnoInt')), id_periodo_academico: Number(bru.getVar('idPeriodoVencido')), id_colegio: Number(bru.getVar('idColegioDoc')), id_grado: Number(bru.getVar('idGradoClase')), id_seccion: Number(bru.getVar('idSeccion')), id_programa: Number(bru.getVar('idPrograma1')), id_nivel_colocado: JSON.parse(bru.getVar('nivelesRk')).F }]);
}

tests {
  test("ítem rechazado: sin_habilitacion o alumno_fuera_del_grupo", function () {
    expect(res.status).to.equal(200);
    const resultados = res.body.resultados || res.body;
    expect(resultados[0].estado).to.equal('rechazada');
    expect(['sin_habilitacion', 'alumno_fuera_del_grupo']).to.include(resultados[0].motivo);
  });
}

docs {
  CU032: la habilitación de un PA no habilita los demás.
}
