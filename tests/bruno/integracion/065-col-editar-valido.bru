meta {
  name: COL editar · válido
  type: http
  seq: 65
}

patch {
  url: {{baseUrl}}/colegios/{{idColegioInt}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "distrito": "Independencia"
  }
}

tests {
  test("200 con el distrito nuevo", function () { expect(res.status).to.equal(200); expect(res.body.distrito).to.equal("Independencia"); });
}
