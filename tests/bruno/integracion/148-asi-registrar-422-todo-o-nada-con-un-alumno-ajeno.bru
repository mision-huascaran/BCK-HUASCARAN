meta {
  name: ASI registrar · 422 todo o nada con un alumno ajeno
  type: http
  seq: 148
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "fecha": "{{fechaClase}}",
    "registros": [
      { "id_alumno": {{idAlumnoInt}}, "estado": "ausente" },
      { "id_alumno": {{idAlumnoSup}}, "estado": "ausente" }
    ]
  }
}

tests {
  test("422 todo o nada con un alumno ajeno", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
  });
}
