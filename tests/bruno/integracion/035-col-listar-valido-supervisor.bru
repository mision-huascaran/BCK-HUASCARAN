meta {
  name: COL listar · válido Supervisor
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/colegios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("paginado y solo activos por defecto", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.every((x) => x.activo)).to.equal(true);
    expect(res.body.page).to.equal(1);
  });
}

docs {
  # Colegios (CU013)

  Solo el Supervisor crea, edita e inactiva. El Docente lee los colegios de su alcance.
  El Directivo no tiene acceso. Nada se elimina.
}
