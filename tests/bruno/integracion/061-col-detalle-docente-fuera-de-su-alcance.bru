meta {
  name: COL detalle · Docente fuera de su alcance
  type: http
  seq: 61
}

get {
  url: {{baseUrl}}/colegios/{{idColegioInt}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("403 o 404: el Docente no ve colegios ajenos", function () { expect([403, 404]).to.include(res.status); });
}
