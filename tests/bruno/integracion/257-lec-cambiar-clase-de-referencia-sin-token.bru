meta {
  name: LEC cambiar clase de referencia · sin token
  type: http
  seq: 257
}

patch {
  url: {{baseUrl}}/lectura/tablas/{{idTabla}}/clase-referencia
  body: json
  auth: none
}

body:json {
  {
    "id_operacion": "{{opRef}}",
    "version": {{versionTabla}},
    "fecha": "{{fechaClase}}"
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
