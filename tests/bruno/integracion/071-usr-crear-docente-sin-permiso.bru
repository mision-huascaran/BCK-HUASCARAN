meta {
  name: USR crear · Docente sin permiso
  type: http
  seq: 71
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombres": "Docente Bruno",
    "apellidos": "Integración {{runUsr}}",
    "dni": "{{dniUsr}}",
    "correo": "{{correoUsr}}",
    "id_rol": {{idRolDocente}},
    "asignacion": {
      "id_colegio": {{idColegioInt}},
      "id_anio_escolar": {{idAnio}},
      "grados": [{{idGrado1}}]
    }
  }
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
