meta {
  name: PER listar · válido
  type: http
  seq: 141
}

get {
  url: {{baseUrl}}/usuarios/{{idUsuarioInt}}/permisos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("incluye el otorgado", function () { expect(res.status).to.equal(200); expect(res.body.items.map((p) => p.id)).to.include(Number(bru.getVar("idPermiso"))); });
}
