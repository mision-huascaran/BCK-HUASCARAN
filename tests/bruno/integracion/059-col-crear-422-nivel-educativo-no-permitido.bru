meta {
  name: COL crear · 422 nivel educativo no permitido
  type: http
  seq: 59
}

post {
  url: {{baseUrl}}/colegios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombre": "I.E. Bruno inválido",
    "departamento": "Áncash",
    "provincia": "Huaraz",
    "nivel_educativo": "Secundaria", "grados": [{ "id_grado": {{idGrado1}}, "dia_clase": 1 }],
    "programas": {{idProgramas}}
  }
}

tests {
  test("422 nivel educativo no permitido", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('nivel_educativo');
  });
}
