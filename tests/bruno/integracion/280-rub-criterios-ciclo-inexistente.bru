meta {
  name: RUB criterios · ciclo inexistente
  type: http
  seq: 280
}

get {
  url: {{baseUrl}}/rubricas/criterios?id_programa={{idPrograma1}}&id_ciclo=99
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("422 ciclo_inexistente", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('ciclo_inexistente');
  });
}
