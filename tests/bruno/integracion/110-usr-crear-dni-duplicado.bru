meta {
  name: USR crear · DNI duplicado
  type: http
  seq: 110
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombres": "Docente Bruno",
    "apellidos": "Integración {{runId}}",
    "dni": "{{dniUsr}}",
    "correo": "{{correoUsr}}",
    "id_rol": {{idRolDocente}},
    "asignacion": {
      "id_anio_escolar": {{idAnio}},
      "colegios": [{ "id_colegio": {{idColegioInt}}, "grados": [{{idGrado1}}] }]
    }
  }
}

tests {
  test("409 duplicado", function () { expect(res.status).to.equal(409); expect(["dni_duplicado", "correo_duplicado"]).to.include(res.body.motivo); });
}
