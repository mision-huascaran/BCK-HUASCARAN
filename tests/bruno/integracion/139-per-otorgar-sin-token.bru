meta {
  name: PER otorgar · sin token
  type: http
  seq: 139
}

post {
  url: {{baseUrl}}/usuarios/{{idUsuarioInt}}/permisos
  body: json
  auth: none
}

body:json {
  {
    "id_anio_escolar": {{idAnio}},
    "id_colegio": {{idColegioInt}},
    "id_grado": {{idGrado1}},
    "id_periodo_academico": {{idPeriodoVencido}},
    "modulo": "lectura",
    "desde_ahora": true,
    "fin": "{{finPermiso}}",
    "motivo": "Faltó registrar la lectura (prueba Bruno)."
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
