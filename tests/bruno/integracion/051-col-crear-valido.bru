meta {
  name: COL crear · válido
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/colegios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombre": "{{nombreColegioInt}}",
    "departamento": "Áncash",
    "provincia": "Huaraz",
    "grados": [
      { "id_grado": {{idGrado1}}, "dia_clase": 3, "secciones": ["A", "B"] },
      { "id_grado": {{idGrado2}}, "dia_clase": 4 }
    ],
    "programas": {{idProgramas}}
  }
}

script:pre-request {
  bru.setVar('nombreColegioInt', 'I.E. Bruno Integración ' + bru.getVar('runId'));
}

script:post-response {
  bru.setVar('idColegioInt', res.body.id);
  const g1 = res.body.grados.find((g) => g.id === Number(bru.getVar('idGrado1')));
  bru.setVar('idSeccionIntA', g1.secciones[0].id);
}

tests {
  test("201 activo; distrito opcional; secciones por grado", function () {
    expect(res.status).to.equal(201);
    expect(res.body.activo).to.equal(true);
    expect(res.body.distrito).to.equal(null);
    expect(res.body.nivel_educativo).to.equal('Primaria');
    expect(res.body.grados.map((g) => g.secciones.length)).to.have.members([2, 1]);
  });
}
