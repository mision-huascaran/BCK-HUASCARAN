meta {
  name: SYN descartar · Supervisor sin permiso
  type: http
  seq: 238
}

post {
  url: {{baseUrl}}/sincronizacion/operaciones/{{opRechazada}}/descartar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
