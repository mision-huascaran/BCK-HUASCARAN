meta {
  name: SES seguimiento de un docente · válido
  type: http
  seq: 172
}

get {
  url: {{baseUrl}}/seguimiento/docentes/{{idDocente}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("cabecera", function () { expect(res.body.id_docente).to.equal(bru.getVar("idDocente")); });
}
