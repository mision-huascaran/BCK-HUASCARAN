meta {
  name: CAT periodos académicos · válido
  type: http
  seq: 32
}

get {
  url: {{baseUrl}}/periodos-academicos?id_anio_escolar={{idAnio}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("PA1 a PA4 del calendario general, a lo más uno vigente", function () {
    expect(res.status).to.equal(200);
    expect(res.body.map((p) => p.tipo)).to.deep.equal(['PA', 'PA', 'PA', 'PA']);
    expect(res.body.filter((p) => p.vigente).length).to.be.at.most(1);
  });
}
