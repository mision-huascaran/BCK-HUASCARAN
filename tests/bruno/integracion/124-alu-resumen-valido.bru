meta {
  name: ALU resumen · válido
  type: http
  seq: 124
}

get {
  url: {{baseUrl}}/alumnos/{{idAlumnoInt}}/resumen
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("forma del resumen", function () {
    expect(res.status).to.equal(200);
    expect(res.body.libros_leidos_anio).to.be.a('number');
    expect(res.body.asistencia_porcentaje).to.be.a('number');
  });
}
