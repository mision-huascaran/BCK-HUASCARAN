meta {
  name: SES mis actividades · válido
  type: http
  seq: 308
}

get {
  url: {{baseUrl}}/actividades
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("la actividad recién finalizada encabeza la lista, con productividad en el formato de CU021", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items[0].id).to.equal(bru.getVar('idActividadInt'));
    expect(res.body.items[0].productividad_texto).to.match(/\b1 en Asistencias\b/);
  });
}

docs {
  CU021: "{n} en {Módulo}", con el nombre del módulo fijo ("1 en Asistencias", "5 en Rúbrica").
}
