meta {
  name: COL inactivar · Docente sin permiso
  type: http
  seq: 61
}

patch {
  url: {{baseUrl}}/colegios/{{idColegioInt}}/desactivar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
