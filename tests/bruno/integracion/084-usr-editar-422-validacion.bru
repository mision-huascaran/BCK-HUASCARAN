meta {
  name: USR editar · 422 validacion
  type: http
  seq: 84
}

patch {
  url: {{baseUrl}}/usuarios/{{idUsuarioInt}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "dni": null
  }
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('dni');
  });
}
