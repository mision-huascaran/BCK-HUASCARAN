meta {
  name: COL detalle · válido
  type: http
  seq: 51
}

get {
  url: {{baseUrl}}/colegios/{{idColegioInt}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("grados con su día de clase", function () {
    expect(res.status).to.equal(200);
    expect(res.body.grados.every((g) => g.dia_clase >= 1 && g.dia_clase <= 5)).to.equal(true);
  });
}
