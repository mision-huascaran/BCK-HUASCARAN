meta {
  name: SES mis actividades · 422 validacion
  type: http
  seq: 162
}

get {
  url: {{baseUrl}}/actividades?estado=pausada
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('estado');
  });
}
