meta {
  name: ALU inactivar · sin token
  type: http
  seq: 194
}

patch {
  url: {{baseUrl}}/alumnos/{{idAlumnoInt}}/desactivar
  body: json
  auth: none
}

body:json {
  {
    "aplicar_desde": "{{hoy}}"
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
