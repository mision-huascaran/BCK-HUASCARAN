meta {
  name: SYN resultado de una operación · Supervisor sin permiso
  type: http
  seq: 230
}

get {
  url: {{baseUrl}}/sincronizacion/operaciones/{{opAsistencia}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
