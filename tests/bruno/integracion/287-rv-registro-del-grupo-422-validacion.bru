meta {
  name: RV registro del grupo · 422 validacion
  type: http
  seq: 287
}

get {
  url: {{baseUrl}}/registro-vuelo?id_colegio={{idColegioDoc}}&id_programa={{idPrograma1}}&id_grado={{idGradoClase}}&id_anio_escolar={{idAnio}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('id_seccion');
  });
}
