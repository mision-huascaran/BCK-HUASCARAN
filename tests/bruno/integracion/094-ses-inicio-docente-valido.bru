meta {
  name: SES inicio Docente · válido
  type: http
  seq: 94
}

get {
  url: {{baseUrl}}/inicio/docente
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

script:pre-request {
  // Una actividad que quedó abierta por una corrida anterior interrumpida se finaliza.
  const base = bru.getEnvVar('baseUrl');
  const headers = { Authorization: 'Bearer ' + bru.getVar('tokenDocente') };
  const inicio = await bru.sendRequest({ method: 'GET', url: base + '/inicio/docente', headers });
  if (inicio.data.actividad_activa) {
    await bru.sendRequest({ method: 'POST', url: `${base}/actividades/${inicio.data.actividad_activa.id}/finalizar`, headers, data: {} });
  }
}

tests {
  test("puede iniciar una actividad", function () {
    expect(res.status).to.equal(200);
    expect(res.body.puede_iniciar_actividad).to.equal(true);
    expect(res.body.motivo_no_puede_iniciar).to.equal(null);
  });
}

docs {
  # Sesiones de trabajo (CU009, CU010, CU017 a CU021)

  Lo que los CU llaman "sesión" de trabajo es una actividad: solo el Docente la inicia y
  la finaliza; el Supervisor la consulta en Seguimiento.
}
