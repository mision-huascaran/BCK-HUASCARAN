meta {
  name: CAT años escolares · válido
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/anios-escolares
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

script:post-response {
  bru.setVar('idAnio', (res.body.find((a) => a.vigente) || res.body[res.body.length - 1]).id);
}

tests {
  test("uno vigente", function () {
    expect(res.status).to.equal(200);
    expect(res.body.filter((a) => a.vigente).length).to.equal(1);
  });
}
