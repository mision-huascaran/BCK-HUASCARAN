meta {
  name: ASI consultar · fin de semana
  type: http
  seq: 140
}

get {
  url: {{baseUrl}}/asistencias?id_colegio={{idColegioDoc}}&id_grado={{idGradoDoc}}&id_programa={{idProgramaDoc}}&fecha={{fechaSabado}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

script:pre-request {
  const d = new Date(Date.now() - 5 * 3600e3);
  d.setUTCDate(d.getUTCDate() - ((d.getUTCDay() + 1) % 7));
  bru.setVar('fechaSabado', d.toISOString().slice(0, 10));
}

tests {
  test("422 fecha_no_lectiva", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('fecha_no_lectiva');
  });
}
