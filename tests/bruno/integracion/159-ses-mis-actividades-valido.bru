meta {
  name: SES mis actividades · válido
  type: http
  seq: 159
}

get {
  url: {{baseUrl}}/actividades
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("la actividad recién finalizada encabeza la lista", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items[0].id).to.equal(bru.getVar('idActividadInt'));
    expect(res.body.items[0].productividad_texto).to.match(/Asistencias/);
  });
}
