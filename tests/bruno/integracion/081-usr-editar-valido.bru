meta {
  name: USR editar · válido
  type: http
  seq: 81
}

patch {
  url: {{baseUrl}}/usuarios/{{idUsuarioInt}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombres": "Docente Bruno Editado"
  }
}

tests {
  test("200", function () {
    expect(res.status).to.equal(200);
    expect(res.body.nombres).to.equal('Docente Bruno Editado');
  });
}
