meta {
  name: USR crear Docente · válido
  type: http
  seq: 106
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombres": "Docente Bruno",
    "apellidos": "Integración {{runId}}",
    "dni": "{{dniUsr}}",
    "correo": "{{correoUsr}}",
    "id_rol": {{idRolDocente}},
    "asignacion": {
      "id_colegio": {{idColegioInt}},
      "id_anio_escolar": {{idAnio}},
      "grados": [{{idGrado1}}]
    }
  }
}

script:pre-request {
  const run = bru.getVar('runId');
  bru.setVar('dniUsr', '6' + run.slice(-7));
  bru.setVar('dniUsr2', '5' + run.slice(-7));
  const base = bru.getEnvVar('correoAvisos');
  bru.setVar('correoUsr', base.replace(/\+[^@]*@|@/, `+bruno.int${run}@`));
  bru.setVar('correoUsr2', base.replace(/\+[^@]*@|@/, `+bruno.int2${run}@`));
}

script:post-response {
  bru.setVar('idUsuarioInt', res.body.usuario.id);
}

tests {
  test("201 con cambio de contraseña pendiente", function () {
    expect(res.status).to.equal(201);
    expect(res.body.usuario.debe_cambiar_contrasena).to.equal(true);
    expect(res.body.usuario.colegios_asignados).to.include(bru.getVar('nombreColegioInt'));
  });
}
