meta {
  name: SES seguimiento de un docente · 422 validacion
  type: http
  seq: 324
}

get {
  url: {{baseUrl}}/seguimiento/docentes/abc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('id_docente');
  });
}
