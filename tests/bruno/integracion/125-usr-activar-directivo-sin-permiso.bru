meta {
  name: USR activar · Directivo sin permiso
  type: http
  seq: 125
}

patch {
  url: {{baseUrl}}/usuarios/{{idUsuarioInt}}/activar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
