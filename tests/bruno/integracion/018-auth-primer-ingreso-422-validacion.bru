meta {
  name: AUTH primer ingreso · 422 validacion
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/password/primer-ingreso
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{correoInexistente}}"
  }
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('contraseña_temporal');
  });
}
