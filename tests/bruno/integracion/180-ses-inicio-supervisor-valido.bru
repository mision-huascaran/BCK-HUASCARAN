meta {
  name: SES inicio Supervisor · válido
  type: http
  seq: 180
}

get {
  url: {{baseUrl}}/inicio/supervisor
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("forma de los contadores y las alertas (los valores dependen de la fecha)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.registros_vencidos).to.be.a('number');
    expect(res.body.registros_incompletos).to.be.a('number');
    for (const a of res.body.alertas) {
      expect(['sincronizacion_olvidada', 'inactividad_operativa', 'incumplimiento_sede']).to.include(a.tipo);
      expect(a.critica).to.equal(a.tipo === 'incumplimiento_sede');
      expect(a.mensaje).to.be.a('string');
    }
  });
}

docs {
  CU011: se valida la forma, no los números (dependen del día real).
}
