meta {
  name: COL ubicaciones · Directivo sin permiso
  type: http
  seq: 47
}

get {
  url: {{baseUrl}}/colegios/ubicaciones
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
