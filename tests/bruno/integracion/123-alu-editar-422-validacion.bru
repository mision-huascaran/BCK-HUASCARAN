meta {
  name: ALU editar · 422 validacion
  type: http
  seq: 123
}

patch {
  url: {{baseUrl}}/alumnos/{{idAlumnoInt}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombres": null
  }
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('nombres');
  });
}
