meta {
  name: LEC registrar filas · Supervisor sin permiso
  type: http
  seq: 254
}

put {
  url: {{baseUrl}}/lectura/tablas/{{idTabla}}/filas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  []
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  req.setBody([{ id_operacion: uuid(), version: Number(bru.getVar('versionFila')), id_alumno: Number(bru.getVar('idAlumnoInt')), observacion: 'x' }]);
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
