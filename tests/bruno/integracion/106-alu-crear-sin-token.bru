meta {
  name: ALU crear · sin token
  type: http
  seq: 106
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Alumno Bruno",
    "apellidos": "Integración {{runUsr}}",
    "id_colegio": {{idColegioDoc}},
    "id_grado": {{idGradoDoc}},
    "id_programa": {{idProgramaDoc}}
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
