meta {
  name: AULA Periodo académico de hoy en el colegio
  type: http
  seq: 167
}

get {
  url: {{baseUrl}}/calendarios/periodo?id_colegio={{idColegioDoc}}&fecha={{hoy}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

script:pre-request {
  const hoyLima = () => new Date(Date.now() - 5 * 3600e3).toISOString().slice(0, 10);
  bru.setVar('hoy', hoyLima());
}

script:post-response {
  bru.setVar('inicioPA', res.body.fecha_inicio);
  bru.setVar('idPeriodoActual', res.body.id_periodo_academico);
}

tests {
  test("el colegio está hoy en un periodo académico (PA)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.tipo, 'sin PA hoy (receso o fuera del calendario): no se puede registrar').to.equal('PA');
  });
}

docs {
  CU027: el calendario de cada colegio define el periodo vigente.
}
