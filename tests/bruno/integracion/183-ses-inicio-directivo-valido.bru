meta {
  name: SES inicio Directivo · válido
  type: http
  seq: 183
}

get {
  url: {{baseUrl}}/inicio/directivo
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

tests {
  test("indicadores sin nombres de alumnos", function () {
    expect(res.status).to.equal(200);
    expect(res.body.beneficiarios_activos).to.be.a('number');
    expect(JSON.stringify(res.body)).to.not.match(/"(nombres|apellidos)"/);
  });
}

