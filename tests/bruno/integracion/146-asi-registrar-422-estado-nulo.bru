meta {
  name: ASI registrar · 422 estado nulo
  type: http
  seq: 146
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "fecha": "{{fechaClase}}",
    "registros": [{ "id_alumno": {{idAlumnoInt}}, "estado": null }]
  }
}

tests {
  test("422 estado nulo", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('estado');
  });
}
