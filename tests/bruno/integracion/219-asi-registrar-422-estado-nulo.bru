meta {
  name: ASI registrar · 422 estado nulo
  type: http
  seq: 219
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {}
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  req.setBody({
    id_colegio: Number(bru.getVar('idColegioDoc')),
    id_grado: Number(bru.getVar('idGradoClase')),
    id_seccion: Number(bru.getVar('idSeccion')),
    fecha: bru.getVar('fechaClase'),
    registros: [{ id_operacion: uuid(), id_alumno: Number(bru.getVar('idAlumnoInt')), estado: null }],
  });
}

tests {
  test("422 estado nulo", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('estado');
  });
}
