meta {
  name: USR crear · aula ya asignada a otro docente
  type: http
  seq: 74
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombres": "Docente Bruno",
    "apellidos": "Aula ocupada",
    "dni": "{{dniUsr2}}",
    "correo": "{{correoUsr2}}",
    "id_rol": {{idRolDocente}},
    "asignacion": {
      "id_colegio": {{idColegioInt}},
      "id_anio_escolar": {{idAnio}},
      "grados": [{{idGrado1}}]
    }
  }
}

script:pre-request {
  const run = String(Date.now());
  bru.setVar('dniUsr2', '5' + run.slice(-7));
  const base = bru.getEnvVar('correoAvisos');
  bru.setVar('correoUsr2', base.replace(/\+[^@]*@|@/, `+bruno.int2${run}@`));
}

tests {
  test("409 grado_asignado", function () {
    expect(res.status).to.equal(409);
    expect(res.body.motivo).to.equal('grado_asignado');
  });
}

docs {
  CU016: uno o más grados ya están asignados a otro docente en el periodo vigente.
}
