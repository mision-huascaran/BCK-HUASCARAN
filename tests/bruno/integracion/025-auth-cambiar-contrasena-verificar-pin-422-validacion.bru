meta {
  name: AUTH cambiar contraseña: verificar PIN · 422 validacion
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/me/password/verificar-codigo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

body:json {
  {}
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('codigo');
  });
}
