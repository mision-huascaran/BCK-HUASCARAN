meta {
  name: SYN resultado de una operación · 422 validacion
  type: http
  seq: 231
}

get {
  url: {{baseUrl}}/sincronizacion/operaciones/abc
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('id_operacion');
  });
}
