meta {
  name: SES iniciar actividad · válido
  type: http
  seq: 161
}

post {
  url: {{baseUrl}}/actividades
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "id_actividad": "{{idActividadInt}}"
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  bru.setVar('idActividadInt', uuid());
}

tests {
  test("201 en curso", function () { expect(res.status).to.equal(201); expect(res.body.actividad.estado).to.equal("en_curso"); });
}
