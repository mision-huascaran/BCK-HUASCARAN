meta {
  name: COL mis asignaciones (Docente)
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/me/asignaciones
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

script:post-response {
  bru.setVar('colegiosDoc', JSON.stringify(res.body.map((a) => a.id_colegio)));
  bru.setVar('idColegioDoc', res.body[0].id_colegio);
  bru.setVar('idGradoDoc', res.body[0].grados[0].id_grado);
  bru.setVar('gradosDoc', JSON.stringify(res.body[0].grados.map((g) => g.id_grado)));
}

tests {
  test("el Docente E2E tiene asignaciones", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.be.greaterThan(0);
  });
}
