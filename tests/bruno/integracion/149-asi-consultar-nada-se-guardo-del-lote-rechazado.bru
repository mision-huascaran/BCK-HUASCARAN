}

get {
  url: {{baseUrl}}/asistencias?id_colegio={{idColegioDoc}}&id_grado={{idGradoDoc}}&id_programa={{idProgramaDoc}}&fecha={{fechaClase}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("el alumno sigue presente", function () {
    const fila = res.body.alumnos.find((a) => a.id_alumno === bru.getVar('idAlumnoInt'));
    expect(fila.estado).to.equal('presente');
  });
}

