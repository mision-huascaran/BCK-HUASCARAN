meta {
  name: CAL crear general · sin token
  type: http
  seq: 83
}

post {
  url: {{baseUrl}}/calendarios
  body: json
  auth: none
}

body:json {
  {
    "id_anio_escolar": {{idAnio}},
    "periodos": {{periodosGeneral}}
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
