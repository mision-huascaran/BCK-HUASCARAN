meta {
  name: COL editar · Docente sin permiso
  type: http
  seq: 58
}

patch {
  url: {{baseUrl}}/colegios/{{idColegioInt}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "distrito": "X"
  }
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
