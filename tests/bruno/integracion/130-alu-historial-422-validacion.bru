meta {
  name: ALU historial · 422 validacion
  type: http
  seq: 130
}

get {
  url: {{baseUrl}}/alumnos/{{idAlumnoInt}}/historial?page=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('page');
  });
}
