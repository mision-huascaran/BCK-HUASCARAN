meta {
  name: ASI consultar · Supervisor en solo lectura
  type: http
  seq: 136
}

get {
  url: {{baseUrl}}/asistencias?id_colegio={{idColegioDoc}}&id_grado={{idGradoDoc}}&id_programa={{idProgramaDoc}}&fecha={{fechaClase}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("no editable", function () { expect(res.status).to.equal(200); expect(res.body.editable).to.equal(false); });
}
