meta {
  name: ALU listar · 422 validacion
  type: http
  seq: 113
}

get {
  url: {{baseUrl}}/alumnos?ciclo=VII
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('ciclo');
  });
}
