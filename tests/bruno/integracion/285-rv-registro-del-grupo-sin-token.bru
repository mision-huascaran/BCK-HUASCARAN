meta {
  name: RV registro del grupo · sin token
  type: http
  seq: 285
}

get {
  url: {{baseUrl}}/registro-vuelo?id_colegio={{idColegioDoc}}&id_programa={{idPrograma1}}&id_grado={{idGradoClase}}&id_seccion={{idSeccion}}&id_anio_escolar={{idAnio}}
  body: none
  auth: none
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
