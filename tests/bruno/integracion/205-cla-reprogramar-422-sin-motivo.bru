meta {
  name: CLA reprogramar · 422 sin motivo
  type: http
  seq: 205
}

post {
  url: {{baseUrl}}/colegios/{{idColegioDoc}}/clases/reprogramaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "id_grado": {{idGradoClase}},
    "id_seccion": {{idSeccion}},
    "fecha_original": "{{fechaFutura}}",
    "fecha_nueva": "{{fechaReprogramada}}"
  }
}

tests {
  test("422 sin motivo", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('motivo');
  });
}
