meta {
  name: ALU resumen · válido
  type: http
  seq: 296
}

get {
  url: {{baseUrl}}/alumnos/{{idAlumnoInt}}/resumen
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("nivel colocado, libros y asistencia del año", function () {
    expect(res.status).to.equal(200);
    expect(res.body.nivel_colocado.letra).to.equal('F');
    expect(res.body.libros_leidos_anio).to.equal(3);
    expect(res.body.asistencia).to.deep.equal({ porcentaje: 100, asistidas: 1, contabilizadas: 1 });
  });
}

docs {
  CU015: el resumen junta el Registro de Vuelo, la lectura y la asistencia del año.
}
