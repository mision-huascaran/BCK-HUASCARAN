meta {
  name: AUTH login · cuenta desactivada
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{correoInactivo}}",
    "password": "{{passInactivo}}"
  }
}

script:pre-request {
  // Las credenciales llegan por variables de entorno (Jenkins Credentials o la terminal);
  // nunca se guardan en el repo.
  const faltan = ['correoInactivo', 'passInactivo'].filter((k) => {
    const valor = bru.interpolate(bru.getEnvVar(k) || '');
    return !valor || valor.includes('{{');
  });
  if (faltan.length) {
    throw new Error('Faltan E2E_INACTIVO_USER / E2E_INACTIVO_PASS en el entorno (ver tests/bruno/README.md)');
  }
}

tests {
  test("403 cuenta_desactivada", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('cuenta_desactivada');
  });
}

docs {
  CU002: una cuenta inactiva no entra aunque la contraseña sea correcta.
}
