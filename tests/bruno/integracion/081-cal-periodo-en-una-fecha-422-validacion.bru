meta {
  name: CAL periodo en una fecha · 422 validacion
  type: http
  seq: 81
}

get {
  url: {{baseUrl}}/calendarios/periodo?id_colegio={{idColegioInt}}&fecha=ayer
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('fecha');
  });
}
