meta {
  name: LEC marcar no realizada · tabla con datos
  type: http
  seq: 260
}

post {
  url: {{baseUrl}}/lectura/tablas/{{idTabla}}/no-realizada
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "id_operacion": "{{opNr}}",
    "version": {{versionTabla}},
    "motivo": "Paro de transportistas"
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  bru.setVar('opNr', uuid());
}

tests {
  test("409 tabla_con_datos", function () {
    expect(res.status).to.equal(409);
    expect(res.body.motivo).to.equal('tabla_con_datos');
  });
}

docs {
  CU026: no se marca "No realizada" una tabla que ya tiene registros de lectura.
}
