meta {
  name: ALU historial · válido
  type: http
  seq: 127
}

get {
  url: {{baseUrl}}/alumnos/{{idAlumnoInt}}/historial
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("creación y edición con valor anterior y nuevo", function () {
    expect(res.status).to.equal(200);
    const acciones = res.body.items.map((e) => e.accion);
    expect(acciones).to.include.members(['crear', 'editar']);
    const edicion = res.body.items.find((e) => e.accion === 'editar');
    expect(edicion.cambios[0].anterior).to.equal('Alumno Bruno');
    expect(edicion.cambios[0].nuevo).to.equal('Alumno Bruno Editado');
  });
}
