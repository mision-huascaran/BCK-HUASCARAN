meta {
  name: COL crear · Docente sin permiso
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/colegios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombre": "{{nombreColegioInt}}",
    "departamento": "Áncash",
    "provincia": "Huaraz",
    "grados": [
      { "id_grado": {{idGrado1}}, "dia_clase": 3, "secciones": ["A", "B"] },
      { "id_grado": {{idGrado2}}, "dia_clase": 4 }
    ],
    "programas": {{idProgramas}}
  }
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
