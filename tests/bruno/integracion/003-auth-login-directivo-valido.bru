meta {
  name: AUTH login Directivo · válido
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{correoDirectivo}}",
    "password": "{{passDirectivo}}"
  }
}

script:pre-request {
  // Las credenciales llegan por variables de entorno (Jenkins Credentials o la terminal);
  // nunca se guardan en el repo.
  const faltan = ['correoDirectivo', 'passDirectivo'].filter((k) => {
    const valor = bru.interpolate(bru.getEnvVar(k) || '');
    return !valor || valor.includes('{{');
  });
  if (faltan.length) {
    throw new Error('Faltan E2E_DIRECTIVO_USER / E2E_DIRECTIVO_PASS en el entorno (ver tests/bruno/README.md)');
  }
}

script:post-response {
  bru.setVar('tokenDirectivo', res.body.access_token);
  bru.setVar('idSesionDirectivo', res.body.sesion.id);
}

tests {
  test("200 con token de 8 h", function () {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a('string');
    expect(res.body.usuario.rol).to.equal('Directivo');
    const horas = (Date.parse(res.body.sesion.expira) - Date.parse(res.body.sesion.inicio)) / 3600e3;
    expect(horas).to.equal(8);
  });
}
