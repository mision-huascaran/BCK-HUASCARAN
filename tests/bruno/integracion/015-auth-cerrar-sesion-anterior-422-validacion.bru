meta {
  name: AUTH cerrar sesión anterior · 422 validacion
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/me/sesiones/{{idSesionSupervisor2}}/cerrar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {}
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('fin');
  });
}
