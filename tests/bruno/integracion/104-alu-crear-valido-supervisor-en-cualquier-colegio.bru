meta {
  name: ALU crear · válido Supervisor en cualquier colegio
  type: http
  seq: 104
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombres": "Alumno Bruno",
    "apellidos": "Supervisor {{runUsr}}",
    "id_colegio": {{idColegioInt}},
    "id_grado": {{idGrado1}},
    "id_programa": {{idProgramaDoc}}
  }
}

script:post-response {
  bru.setVar('idAlumnoSup', res.body.id);
}

tests {
  test("201", function () { expect(res.status).to.equal(201); });
}
