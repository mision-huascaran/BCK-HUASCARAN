meta {
  name: ALU crear · 422 validacion
  type: http
  seq: 108
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombres": "X",
    "apellidos": "Y",
    "id_colegio": {{idColegioDoc}},
    "id_grado": {{idGradoDoc}}
  }
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('id_programa');
  });
}
