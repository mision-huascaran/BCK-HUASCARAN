meta {
  name: ALU crear · Docente fuera de su alcance
  type: http
  seq: 105
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombres": "No debe crearse",
    "apellidos": "Bruno",
    "id_colegio": {{idColegioInt}},
    "id_grado": {{idGrado1}},
    "id_programa": {{idProgramaDoc}}
  }
}

tests {
  test("403: solo en sus colegios y grados", function () {
    expect(res.status).to.equal(403);
  });
}
