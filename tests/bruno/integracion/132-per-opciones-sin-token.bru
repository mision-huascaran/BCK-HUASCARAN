meta {
  name: PER opciones · sin token
  type: http
  seq: 132
}

get {
  url: {{baseUrl}}/permisos/opciones?id_colegio={{idColegioInt}}&id_anio_escolar={{idAnio}}
  body: none
  auth: none
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
