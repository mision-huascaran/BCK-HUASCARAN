meta {
  name: ASI registrar · válido
  type: http
  seq: 215
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {}
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  bru.setVar('opAsistencia', uuid());
  req.setBody({
    id_colegio: Number(bru.getVar('idColegioDoc')),
    id_grado: Number(bru.getVar('idGradoClase')),
    id_seccion: Number(bru.getVar('idSeccion')),
    fecha: bru.getVar('fechaClase'),
    registros: [{ id_operacion: bru.getVar('opAsistencia'), id_alumno: Number(bru.getVar('idAlumnoInt')), estado: 'presente' }],
  });
}

tests {
  test("aceptada", function () {
    expect(res.status).to.equal(200);
    expect(res.body.resultados[0].estado).to.equal('aceptada');
    expect(res.body.resultados[0].registro.estado).to.equal('presente');
  });
}
