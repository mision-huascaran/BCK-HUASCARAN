meta {
  name: RV registrar · Supervisor sin permiso
  type: http
  seq: 292
}

put {
  url: {{baseUrl}}/registro-vuelo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  []
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  req.setBody([{ id_operacion: uuid(), version: null, id_alumno: Number(bru.getVar('idAlumnoInt')), id_periodo_academico: Number(bru.getVar('idPeriodoActual')), id_colegio: Number(bru.getVar('idColegioDoc')), id_grado: Number(bru.getVar('idGradoClase')), id_seccion: Number(bru.getVar('idSeccion')), id_programa: Number(bru.getVar('idPrograma1')), id_nivel_colocado: JSON.parse(bru.getVar('nivelesRk')).F }]);
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
