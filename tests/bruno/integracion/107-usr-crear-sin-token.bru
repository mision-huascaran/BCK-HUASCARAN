meta {
  name: USR crear · sin token
  type: http
  seq: 107
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Docente Bruno",
    "apellidos": "Integración {{runId}}",
    "dni": "{{dniUsr}}",
    "correo": "{{correoUsr}}",
    "id_rol": {{idRolDocente}},
    "asignacion": {
      "id_anio_escolar": {{idAnio}},
      "colegios": [{ "id_colegio": {{idColegioInt}}, "grados": [{{idGrado1}}] }]
    }
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
