meta {
  name: SYN avisar pendientes · 422 módulo inválido
  type: http
  seq: 226
}

post {
  url: {{baseUrl}}/sincronizacion/pendientes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  [
    { "id_operacion": "{{opPendiente}}", "id_dispositivo": "tablet-bruno", "id_actividad": "{{idActividadInt}}",
      "modulo": "otro", "realizado_en": "{{ahora}}" }
  ]
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  bru.setVar('opPendiente', uuid());
  bru.setVar('ahora', new Date().toISOString());
}

tests {
  test("422 módulo inválido", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('modulo');
  });
}
