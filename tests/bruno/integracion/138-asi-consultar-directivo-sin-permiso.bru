meta {
  name: ASI consultar · Directivo sin permiso
  type: http
  seq: 138
}

get {
  url: {{baseUrl}}/asistencias?id_colegio={{idColegioDoc}}&id_grado={{idGradoDoc}}&id_programa={{idProgramaDoc}}&fecha={{fechaClase}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
