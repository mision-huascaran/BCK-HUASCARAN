meta {
  name: SES seguimiento de un docente · Directivo sin permiso
  type: http
  seq: 323
}

get {
  url: {{baseUrl}}/seguimiento/docentes/{{idDocente}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
