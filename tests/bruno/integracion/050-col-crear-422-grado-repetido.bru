meta {
  name: COL crear · 422 grado repetido
  type: http
  seq: 50
}

post {
  url: {{baseUrl}}/colegios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombre": "I.E. Bruno grado repetido",
    "departamento": "Áncash",
    "provincia": "Huaraz",
    "grados": [{ "id_grado": {{idGrado1}}, "dia_clase": 1 }, { "id_grado": {{idGrado1}}, "dia_clase": 2 }],
    "programas": {{idProgramas}}
  }
}

tests {
  test("422 grado repetido", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('grados');
  });
}
