meta {
  name: SYN resultado de una operación desconocida
  type: http
  seq: 228
}

get {
  url: {{baseUrl}}/sincronizacion/operaciones/{{opPendiente}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("desconocida: todavía no llegó", function () { expect(res.status).to.equal(200); expect(res.body.estado).to.equal("desconocida"); });
}
