meta {
  name: SES historial del docente · válido
  type: http
  seq: 325
}

get {
  url: {{baseUrl}}/seguimiento/docentes/{{idDocente}}/actividades
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("incluye la actividad de esta corrida", function () { expect(res.status).to.equal(200); expect(res.body.items.map((a) => a.id)).to.include(bru.getVar("idActividadInt")); });
}
