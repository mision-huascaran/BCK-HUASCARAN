meta {
  name: ALU listar · válido Supervisor
  type: http
  seq: 110
}

get {
  url: {{baseUrl}}/alumnos?id_colegio={{idColegioInt}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("ve el alumno que creó en el colegio de prueba", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.map((a) => a.id)).to.include(bru.getVar('idAlumnoSup'));
  });
}
