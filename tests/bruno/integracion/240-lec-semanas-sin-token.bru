meta {
  name: LEC semanas · sin token
  type: http
  seq: 240
}

get {
  url: {{baseUrl}}/semanas?id_anio_escolar={{idAnio}}&mes={{mesClase}}&id_colegio={{idColegioDoc}}&id_grado={{idGradoClase}}&id_seccion={{idSeccion}}
  body: none
  auth: none
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
