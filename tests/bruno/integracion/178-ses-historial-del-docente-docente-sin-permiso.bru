meta {
  name: SES historial del docente · Docente sin permiso
  type: http
  seq: 178
}

get {
  url: {{baseUrl}}/seguimiento/docentes/{{idDocente}}/actividades
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
