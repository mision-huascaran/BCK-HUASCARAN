meta {
  name: SYN enviar la operación avisada
  type: http
  seq: 235
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {}
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  req.setBody({
    id_colegio: Number(bru.getVar('idColegioDoc')),
    id_grado: Number(bru.getVar('idGradoClase')),
    id_seccion: Number(bru.getVar('idSeccion')),
    fecha: bru.getVar('fechaClase'),
    registros: [{ id_operacion: bru.getVar('opPendiente'), realizado_en: bru.getVar('ahora'), id_alumno: Number(bru.getVar('idAlumnoInt')), estado: 'presente' }],
  });
}

tests {
  test("aceptada", function () { expect(res.status).to.equal(200); expect(res.body.resultados[0].estado).to.equal("aceptada"); });
}
