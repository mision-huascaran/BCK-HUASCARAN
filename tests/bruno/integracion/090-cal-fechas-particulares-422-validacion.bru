meta {
  name: CAL fechas particulares · 422 validacion
  type: http
  seq: 90
}

post {
  url: {{baseUrl}}/calendarios/particulares
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "id_colegio": {{idColegioInt}},
    "id_anio_escolar": {{idAnio}}
  }
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('periodos');
  });
}
