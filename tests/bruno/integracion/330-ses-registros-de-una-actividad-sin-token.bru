meta {
  name: SES registros de una actividad · sin token
  type: http
  seq: 330
}

get {
  url: {{baseUrl}}/seguimiento/docentes/{{idDocente}}/actividades/{{idActividadInt}}/registros?modulo=rubrica
  body: none
  auth: none
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
