meta {
  name: SES finalizar actividad · 422 validacion
  type: http
  seq: 306
}

post {
  url: {{baseUrl}}/actividades/{{idActividadInt}}/finalizar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "fin": "ayer"
  }
}

tests {
  test("422 validacion", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('validacion');
    expect(res.body.errores.map((e) => e.campo).join(' ')).to.include('fin');
  });
}
