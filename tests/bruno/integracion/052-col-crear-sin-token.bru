meta {
  name: COL crear · sin token
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/colegios
  body: json
  auth: none
}

body:json {
  {
    "nombre": "{{nombreColegioInt}}",
    "departamento": "Áncash",
    "provincia": "Huaraz",
    "grados": [
      { "id_grado": {{idGrado1}}, "dia_clase": 3, "secciones": ["A", "B"] },
      { "id_grado": {{idGrado2}}, "dia_clase": 4 }
    ],
    "programas": {{idProgramas}}
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
