meta {
  name: RV pestaña del alumno · Directivo sin permiso
  type: http
  seq: 295
}

get {
  url: {{baseUrl}}/alumnos/{{idAlumnoInt}}/registro-vuelo
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
