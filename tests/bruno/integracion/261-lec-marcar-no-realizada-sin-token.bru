meta {
  name: LEC marcar no realizada · sin token
  type: http
  seq: 261
}

post {
  url: {{baseUrl}}/lectura/tablas/{{idTabla}}/no-realizada
  body: json
  auth: none
}

body:json {
  {
    "id_operacion": "{{opNr}}",
    "version": {{versionTabla}},
    "motivo": "Paro de transportistas"
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
