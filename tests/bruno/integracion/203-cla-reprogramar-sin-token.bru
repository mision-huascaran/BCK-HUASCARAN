meta {
  name: CLA reprogramar · sin token
  type: http
  seq: 203
}

post {
  url: {{baseUrl}}/colegios/{{idColegioDoc}}/clases/reprogramaciones
  body: json
  auth: none
}

body:json {
  {
    "id_grado": {{idGradoClase}},
    "id_seccion": {{idSeccion}},
    "fecha_original": "{{fechaFutura}}",
    "fecha_nueva": "{{fechaReprogramada}}",
    "motivo": "Actuación del colegio (prueba Bruno)"
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
