meta {
  name: USR crear · Directivo sin permiso
  type: http
  seq: 109
}

post {
  url: {{baseUrl}}/usuarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

body:json {
  {
    "nombres": "Docente Bruno",
    "apellidos": "Integración {{runId}}",
    "dni": "{{dniUsr}}",
    "correo": "{{correoUsr}}",
    "id_rol": {{idRolDocente}},
    "asignacion": {
      "id_anio_escolar": {{idAnio}},
      "colegios": [{ "id_colegio": {{idColegioInt}}, "grados": [{{idGrado1}}] }]
    }
  }
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
