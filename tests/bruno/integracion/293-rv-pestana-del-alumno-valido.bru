get {
  url: {{baseUrl}}/alumnos/{{idAlumnoInt}}/registro-vuelo
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("siempre los 4 PA del año", function () { expect(res.status).to.equal(200); expect(res.body.length).to.equal(4); });
}
