meta {
  name: RUB rúbricas del mes · Directivo sin permiso
  type: http
  seq: 269
}

get {
  url: {{baseUrl}}/rubricas?id_colegio={{idColegioDoc}}&id_programa={{idPrograma1}}&id_grado={{idGradoClase}}&id_seccion={{idSeccion}}&id_anio_escolar={{idAnio}}&mes={{mesHoy}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDirectivo}}
}

tests {
  test("403 sin_permiso", function () {
    expect(res.status).to.equal(403);
    expect(res.body.motivo).to.equal('sin_permiso');
  });
}
