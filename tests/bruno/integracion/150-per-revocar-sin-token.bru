meta {
  name: PER revocar · sin token
  type: http
  seq: 150
}

post {
  url: {{baseUrl}}/usuarios/{{idUsuarioInt}}/permisos/{{idPermiso}}/revocar
  body: json
  auth: none
}

body:json {
  {
    "motivo": "x"
  }
}

tests {
  test("401 sesion_invalida", function () {
    expect(res.status).to.equal(401);
    expect(res.body.motivo).to.equal('sesion_invalida');
  });
}
