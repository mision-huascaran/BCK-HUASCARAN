meta {
  name: F5-16 La actividad sincronizada
  type: http
  seq: 77
}

get {
  url: {{baseUrl}}/actividades/{{idActividadOffline}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

tests {
  test("finalizada por el cierre de sesión, sincronizada y con la observación de B", function () {
    expect(res.status).to.equal(200);
    expect(res.body.estado).to.equal('finalizada');
    expect(res.body.tipo_cierre).to.equal('Forzado por cierre de sesión');
    expect(res.body.sincronizacion).to.equal('sincronizada');
    expect(res.body.registros_pendientes).to.equal(0);
    const asistencia = res.body.cambios_por_modulo.find((m) => m.modulo === 'asistencia');
    expect(asistencia.total).to.equal(1);
  });
}
