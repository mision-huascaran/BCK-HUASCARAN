meta {
  name: F1-12 Resumen del alumno nuevo
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/alumnos/{{idAlumnoF1}}/resumen
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("sin registros todavía: nivel null, 0 libros y 0 % de asistencia", function () {
    expect(res.status).to.equal(200);
    expect(res.body.nivel_colocado).to.equal(null);
    expect(res.body.libros_leidos_anio).to.equal(0);
    expect(res.body.asistencia_porcentaje).to.equal(0);
  });
}

docs {
  CU015: el detalle muestra 0 y 0 % cuando aún no hay datos.
}
