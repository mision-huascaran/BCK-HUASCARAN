meta {
  name: F1-10 Ficha del alumno creado
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/alumnos/{{idAlumnoF1}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("pertenece a su grupo desde hoy", function () {
    expect(res.status).to.equal(200);
    expect(res.body.fecha_registro).to.equal(bru.getVar('hoy'));
    expect(res.body.pertenece_desde).to.equal(bru.getVar('hoy'));
  });
}
