meta {
  name: F2-09 Marcar todos como presentes
  type: http
  seq: 29
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {}
}

script:pre-request {
  const ids = JSON.parse(bru.getVar('sinMarcar'));
  req.setBody({ fecha: bru.getVar('fechaClase'), registros: ids.map((id) => ({ id_alumno: id, estado: 'presente' })) });
}

tests {
  test("todos aplicados como presentes", function () {
    expect(res.status).to.equal(200);
    expect(res.body.registros.length).to.equal(JSON.parse(bru.getVar('sinMarcar')).length);
    for (const r of res.body.registros) {
      expect(r.aplicado).to.equal(true);
      expect(r.estado).to.equal('presente');
    }
  });
}
