meta {
  name: F6-11 LSN con nota mayor al máximo
  type: http
  seq: 91
}

put {
  url: {{baseUrl}}/lectura/tablas/{{idTabla}}/filas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  []
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  req.setBody([{ id_operacion: uuid(), version: Number(bru.getVar('versionFilaB')), id_alumno: Number(bru.getVar('idAlumnoB')), lsn_titulo: 'El zorro', lsn_nota: 7, lsn_maximo: 5 }]);
}

tests {
  test("ítem rechazado: lsn_invalido", function () {
    expect(res.status).to.equal(200);
    const resultados = res.body.resultados || res.body;
    expect(resultados[0].estado).to.equal('rechazada');
    expect(['lsn_invalido']).to.include(resultados[0].motivo);
  });
}
