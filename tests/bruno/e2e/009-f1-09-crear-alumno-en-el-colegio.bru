meta {
  name: F1-09 Crear alumno en el colegio
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombres": "Alumno Bruno",
    "apellidos": "F1 {{runId}}",
    "id_colegio": {{idColegioF1}},
    "id_grado": {{idGrado1}},
    "id_programa": {{idPrograma1}}
  }
}

script:post-response {
  bru.setVar('idAlumnoF1', res.body.id);
}

tests {
  test("201 activo en su colegio, grado y sección", function () {
    expect(res.status).to.equal(201);
    expect(res.body.activo).to.equal(true);
    expect(res.body.colegio.id).to.equal(bru.getVar('idColegioF1'));
    expect(res.body.grado.id).to.equal(bru.getVar('idGrado1'));
    expect(res.body.seccion).to.equal('Única');
  });
}

docs {
  CU014: el Supervisor crea alumnos en cualquier colegio (sin actividad de trabajo).
}
