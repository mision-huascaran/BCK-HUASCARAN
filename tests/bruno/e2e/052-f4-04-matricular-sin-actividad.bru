meta {
  name: F4-04 Matricular sin actividad
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombres": "No debe crearse",
    "apellidos": "Bruno F4",
    "id_colegio": {{idColegioDoc}},
    "id_grado": {{idGradoClase}},
    "id_seccion": {{idSeccion}},
    "id_programa": {{idPrograma1}},
    "pertenece_desde": "{{hoy}}"
  }
}

tests {
  test("409 actividad_requerida", function () {
    expect(res.status).to.equal(409);
    expect(res.body.motivo).to.equal('actividad_requerida');
  });
}
