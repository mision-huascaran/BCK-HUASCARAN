meta {
  name: F5-04 Iniciar actividad (con conexión)
  type: http
  seq: 62
}

post {
  url: {{baseUrl}}/actividades
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "id_actividad": "{{idActividadOnline}}"
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  bru.setVar('idActividadOnline', uuid());
}

tests {
  test("201", function () { expect(res.status).to.equal(201); });
}
