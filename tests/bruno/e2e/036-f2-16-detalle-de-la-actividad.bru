meta {
  name: F2-16 Detalle de la actividad
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/actividades/{{idActividadF2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("cuenta los cambios por módulo de esta actividad", function () {
    expect(res.status).to.equal(200);
    const modulo = (m) => res.body.cambios_por_modulo.find((x) => x.modulo === m) || {};
    // Varios clics sobre el mismo alumno en una actividad cuentan como un solo cambio.
    expect(modulo('asistencia').total).to.be.at.least(2);
    expect(modulo('alumnos').creados).to.be.at.least(2);
    expect(modulo('alumnos').editados).to.be.at.least(1);
    expect(modulo('alumnos').inactivados).to.be.at.least(2);
    expect(res.body.registros_pendientes).to.equal(0);
  });
}

docs {
  CU019: el detalle de una sesión de trabajo se alimenta de la auditoría ligada a la actividad.
}
