meta {
  name: F1-15 Grilla con el filtro Inactivo
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/alumnos?id_colegio={{idColegioF1}}&activo=false
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("el alumno sigue existiendo como inactivo", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.map((a) => a.id)).to.include(bru.getVar('idAlumnoF1'));
  });
}
