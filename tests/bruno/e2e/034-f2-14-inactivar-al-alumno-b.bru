meta {
  name: F2-14 Inactivar al alumno B
  type: http
  seq: 34
}

patch {
  url: {{baseUrl}}/alumnos/{{idAlumnoB}}/desactivar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("queda inactivo (limpieza del aula de pruebas)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.activo).to.equal(false);
  });
}
