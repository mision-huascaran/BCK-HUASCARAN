meta {
  name: F5-10 Reintento de la misma actividad
  type: http
  seq: 71
}

post {
  url: {{baseUrl}}/actividades
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

body:json {
  {
    "id_actividad": "{{idActividadOffline}}",
    "inicio": "{{tInicioOffline}}",
    "id_sesion": "{{idSesionA}}"
  }
}

tests {
  test("200 con la misma actividad: no se duplica", function () {
    expect(res.status).to.equal(200);
    expect(res.body.actividad.id).to.equal(bru.getVar('idActividadOffline'));
  });
}
