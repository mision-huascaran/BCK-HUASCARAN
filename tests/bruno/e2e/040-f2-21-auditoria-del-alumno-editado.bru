meta {
  name: F2-21 Auditoría del alumno editado
  type: http
  seq: 40
}

get {
  url: {{baseUrl}}/alumnos/{{idAlumnoA}}/historial
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("la edición guarda el valor anterior y el nuevo, dentro de la actividad", function () {
    expect(res.status).to.equal(200);
    const run = bru.getVar('runId');
    const edicion = res.body.items.find((e) => e.accion === 'editar' && e.cambios.some((x) => x.campo.toLowerCase() === 'apellidos'));
    expect(edicion, 'evento editar').to.not.equal(undefined);
    const cambio = edicion.cambios.find((x) => x.campo.toLowerCase() === 'apellidos');
    expect(cambio.anterior).to.equal('Bruno ' + run);
    expect(cambio.nuevo).to.equal('Bruno ' + run + ' editado');
    expect(Date.parse(edicion.fecha)).to.be.within(Date.parse(bru.getVar('inicioF2')), Date.parse(bru.getVar('finF2')));
  });
}
