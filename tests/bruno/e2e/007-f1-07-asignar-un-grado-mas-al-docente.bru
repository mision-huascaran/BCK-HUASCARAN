meta {
  name: F1-07 Asignar un grado más al docente
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/usuarios/{{idUsuarioF1}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "asignacion": {
      "id_anio_escolar": {{idAnio}},
      "colegios": [{ "id_colegio": {{idColegioF1}}, "grados": [{{idGrado1}}, {{idGrado2}}] }]
    }
  }
}

tests {
  test("200", function () { expect(res.status).to.equal(200); });
}
