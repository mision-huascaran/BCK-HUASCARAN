meta {
  name: F1-05 Crear colegio con día de clase por grado
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/colegios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "nombre": "{{nombreColegio}}",
    "departamento": "Áncash",
    "provincia": "Huaraz",
    "distrito": "{{distritoColegio}}",
    "grados": [
      { "id_grado": {{idGrado1}}, "dia_clase": 1 },
      { "id_grado": {{idGrado2}}, "dia_clase": 2 }
    ],
    "programas": {{idProgramas}}
  }
}

script:pre-request {
  bru.setVar('nombreColegio', 'I.E. Bruno E2E ' + bru.getVar('runId'));
  // Distrito único por corrida: permite encontrar el colegio con el filtro de la grilla.
  bru.setVar('distritoColegio', 'Bruno ' + bru.getVar('runId'));
}

script:post-response {
  bru.setVar('idColegioF1', res.body.id);
}

tests {
  test("201 activo, con el día de clase de cada grado", function () {
    expect(res.status).to.equal(201);
    expect(res.body.activo).to.equal(true);
    expect(res.body.provincia).to.equal('Huaraz');
    const dias = Object.fromEntries(res.body.grados.map((g) => [g.id, g.dia_clase]));
    expect(dias[bru.getVar('idGrado1')]).to.equal(1);
    expect(dias[bru.getVar('idGrado2')]).to.equal(2);
  });
}

docs {
  CU013: el día de clase de cada grado y la provincia son obligatorios.
}
