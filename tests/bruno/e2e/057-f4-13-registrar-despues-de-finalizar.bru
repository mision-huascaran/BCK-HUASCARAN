meta {
  name: F4-13 Registrar después de finalizar
  type: http
  seq: 57
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "fecha": "{{fechaClase}}",
    "registros": [{ "id_alumno": {{idAlumnoCualquiera}}, "estado": "presente" }]
  }
}

tests {
  test("409 actividad_requerida", function () {
    expect(res.status).to.equal(409);
    expect(res.body.motivo).to.equal('actividad_requerida');
  });
}
