meta {
  name: F5-20 La clase conserva el más reciente
  type: http
  seq: 78
}

get {
  url: {{baseUrl}}/asistencias?id_colegio={{idColegioDoc}}&id_grado={{idGradoDoc}}&id_programa={{idProgramaDoc}}&fecha={{fechaClase}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

tests {
  test("el alumno C queda ausente", function () {
    const c = res.body.alumnos.find((a) => a.id_alumno === bru.getVar('idAlumnoC'));
    expect(c.estado).to.equal('ausente');
  });
}
