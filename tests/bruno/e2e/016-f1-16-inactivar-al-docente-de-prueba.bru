meta {
  name: F1-16 Inactivar al docente de prueba
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/usuarios/{{idUsuarioF1}}/desactivar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("queda inactivo", function () {
    expect(res.status).to.equal(200);
    expect(res.body.activo).to.equal(false);
  });
}
