meta {
  name: F5-01 Docente inicia sesión (dispositivo con caída)
  type: http
  seq: 59
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{correoDocente}}",
    "password": "{{passDocente}}"
  }
}

script:pre-request {
  // Las credenciales llegan por variables de entorno (Jenkins Credentials o la terminal);
  // nunca se guardan en el repo.
  const faltan = ['correoDocente', 'passDocente'].filter((k) => {
    const valor = bru.interpolate(bru.getEnvVar(k) || '');
    return !valor || valor.includes('{{');
  });
  if (faltan.length) {
    throw new Error('Faltan E2E_DOCENTE_USER / E2E_DOCENTE_PASS en el entorno (ver tests/bruno/README.md)');
  }
}

script:post-response {
  bru.setVar('tokenDocente', res.body.access_token);
  bru.setVar('idSesionA', res.body.sesion.id);
}

tests {
  test("200 con token de 8 h", function () {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a('string');
    expect(res.body.usuario.rol).to.equal('Docente');
    const horas = (Date.parse(res.body.sesion.expira) - Date.parse(res.body.sesion.inicio)) / 3600e3;
    expect(horas).to.equal(8);
  });
}

docs {
  # F5. Sincronización tras una caída de internet (CU007, CU008, CU009, CU022)

  1. Con conexión, el Docente matricula un alumno (crear alumnos es solo en línea).
  2. Se cae internet: sin enviar nada, inicia una actividad, marca la asistencia y cierra
     sesión. Todo queda en IndexedDB con su hora real.
  3. Vuelve la conexión y entra de nuevo: el cliente envía la cola en orden (la actividad
     de la sesión anterior, la asistencia y el cierre de esa sesión). Reintentar no duplica.
  4. Dos dispositivos editan al mismo alumno: gana la captura más reciente (CU022, paso 10).

  La caída se simula no enviando las peticiones hasta el paso 3, con las horas reales de
  la captura.
}
