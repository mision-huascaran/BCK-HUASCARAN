meta {
  name: F5-05 Matricular alumno C (con conexión)
  type: http
  seq: 63
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombres": "Alumno C",
    "apellidos": "Bruno F5 {{runId}}",
    "id_colegio": {{idColegioDoc}},
    "id_grado": {{idGradoDoc}},
    "id_programa": {{idProgramaDoc}}
  }
}

script:pre-request {
  if (!bru.getVar('runId')) bru.setVar('runId', String(Date.now()));
}

script:post-response {
  bru.setVar('idAlumnoC', res.body.id);
}

tests {
  test("201", function () { expect(res.status).to.equal(201); });
}
