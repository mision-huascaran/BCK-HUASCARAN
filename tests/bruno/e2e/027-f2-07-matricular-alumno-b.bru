meta {
  name: F2-07 Matricular alumno B
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombres": "Alumno B",
    "apellidos": "Bruno F2 {{runId}}",
    "id_colegio": {{idColegioDoc}},
    "id_grado": {{idGradoDoc}},
    "id_programa": {{idProgramaDoc}}
  }
}

script:post-response {
  bru.setVar('idAlumnoB', res.body.id);
}

tests {
  test("201 en el aula del Docente", function () {
    expect(res.status).to.equal(201);
    expect(res.body.colegio.id).to.equal(bru.getVar('idColegioDoc'));
    expect(res.body.grado.id).to.equal(bru.getVar('idGradoDoc'));
  });
}
