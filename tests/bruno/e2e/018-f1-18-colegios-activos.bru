meta {
  name: F1-18 Colegios activos
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/colegios?distrito={{distritoColegio}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("el colegio inactivo no aparece con el filtro por defecto", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items.map((x) => x.id)).to.not.include(bru.getVar('idColegioF1'));
  });
}
