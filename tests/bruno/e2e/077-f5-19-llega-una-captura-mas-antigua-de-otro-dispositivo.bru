meta {
  name: F5-19 Llega una captura más antigua de otro dispositivo
  type: http
  seq: 77
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

body:json {
  {
    "fecha": "{{fechaClase}}",
    "registros": [{ "id_alumno": {{idAlumnoC}}, "estado": "tardanza" }],
    "fecha_registro": "{{tCaptura}}"
  }
}

tests {
  test("no se aplica: gana la captura más reciente", function () {
    expect(res.status).to.equal(200);
    expect(res.body.registros[0].aplicado).to.equal(false);
    expect(res.body.registros[0].estado).to.equal('ausente');
  });
}

docs {
  CU022, paso 10: con registros simultáneos desde dos dispositivos prevalece la marca de tiempo más reciente.
}
