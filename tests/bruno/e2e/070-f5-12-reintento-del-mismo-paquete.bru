meta {
  name: F5-12 Reintento del mismo paquete
  type: http
  seq: 70
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

body:json {
  {
    "fecha": "{{fechaClase}}",
    "registros": [{ "id_alumno": {{idAlumnoC}}, "estado": "presente" }],
    "fecha_registro": "{{tCaptura}}"
  }
}

tests {
  test("mismo resultado, sin error", function () {
    expect(res.status).to.equal(200);
    expect(res.body.registros[0].estado).to.equal('presente');
  });
}

docs {
  RNF-001 / CU022: el reintento al reconectar no debe duplicar el registro.
}
