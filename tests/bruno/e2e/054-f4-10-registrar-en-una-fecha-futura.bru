meta {
  name: F4-10 Registrar en una fecha futura
  type: http
  seq: 54
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "fecha": "{{fechaFutura}}",
    "registros": [{ "id_alumno": {{idAlumnoCualquiera}}, "estado": "presente" }]
  }
}

script:pre-request {
  const d = new Date(Date.now() - 5 * 3600e3 + 7 * 86400e3);
  bru.setVar('fechaFutura', d.toISOString().slice(0, 10));
}

tests {
  test("422 fecha_no_lectiva", function () {
    expect(res.status).to.equal(422);
    expect(res.body.motivo).to.equal('fecha_no_lectiva');
  });
}

docs {
  CU022: prohibido registrar asistencias en fechas futuras; el backend es la fuente de verdad de la fecha.
}
