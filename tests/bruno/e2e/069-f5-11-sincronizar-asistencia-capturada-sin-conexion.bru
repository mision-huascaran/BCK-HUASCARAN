meta {
  name: F5-11 Sincronizar: asistencia capturada sin conexión
  type: http
  seq: 69
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

body:json {
  {
    "fecha": "{{fechaClase}}",
    "registros": [{ "id_alumno": {{idAlumnoC}}, "estado": "presente" }],
    "fecha_registro": "{{tCaptura}}"
  }
}

tests {
  test("aplicada como presente", function () {
    expect(res.status).to.equal(200);
    expect(res.body.registros[0].aplicado).to.equal(true);
    expect(res.body.registros[0].estado).to.equal('presente');
  });
}
