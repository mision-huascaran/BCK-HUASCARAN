meta {
  name: F5-12 Reintento del mismo lote
  type: http
  seq: 73
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

body:json {
  {}
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  req.setBody({
    id_colegio: Number(bru.getVar('idColegioDoc')),
    id_grado: Number(bru.getVar('idGradoClase')),
    id_seccion: Number(bru.getVar('idSeccion')),
    fecha: bru.getVar('fechaClase'),
    registros: [
      { id_operacion: bru.getVar('opA'), realizado_en: bru.getVar('tCaptura'), id_actividad: bru.getVar('idActividadOffline'),
        id_alumno: Number(bru.getVar('idAlumnoA')), estado: 'tardanza' },
      { id_operacion: bru.getVar('opB'), realizado_en: bru.getVar('tCaptura'), id_actividad: bru.getVar('idActividadOffline'),
        id_alumno: Number(bru.getVar('idAlumnoB')), observacion: 'Registrado sin conexión' },
    ],
  });
}

tests {
  test("misma respuesta: no se duplica ni se vuelve a aplicar", function () {
    expect(res.status).to.equal(200);
    expect(res.body.resultados).to.deep.equal(JSON.parse(bru.getVar('resultadoSync')));
  });
}

docs {
  RNF-001: el reintento al reconectar no duplica el registro.
}
