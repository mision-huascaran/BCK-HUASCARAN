meta {
  name: F2-11 Consultar la clase
  type: http
  seq: 31
}

get {
  url: {{baseUrl}}/asistencias?id_colegio={{idColegioDoc}}&id_grado={{idGradoDoc}}&id_programa={{idProgramaDoc}}&fecha={{fechaClase}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("refleja la tardanza con su observación y el presente", function () {
    expect(res.status).to.equal(200);
    const a = res.body.alumnos.find((x) => x.id_alumno === bru.getVar('idAlumnoA'));
    const b = res.body.alumnos.find((x) => x.id_alumno === bru.getVar('idAlumnoB'));
    expect(a.estado).to.equal('tardanza');
    expect(a.observacion).to.equal('Llegó tarde por el transporte');
    expect(b.estado).to.equal('presente');
  });
}
