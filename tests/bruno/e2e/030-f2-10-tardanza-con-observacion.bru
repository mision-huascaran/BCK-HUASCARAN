meta {
  name: F2-10 Tardanza con observación
  type: http
  seq: 30
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "fecha": "{{fechaClase}}",
    "registros": [
      { "id_alumno": {{idAlumnoA}}, "estado": "tardanza", "observacion": "Llegó tarde por el transporte" }
    ]
  }
}

tests {
  test("aplicada", function () {
    expect(res.status).to.equal(200);
    const r = res.body.registros[0];
    expect(r.aplicado).to.equal(true);
    expect(r.estado).to.equal('tardanza');
    expect(r.observacion).to.equal('Llegó tarde por el transporte');
  });
}
