meta {
  name: F1-13 Inactivar al alumno
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/alumnos/{{idAlumnoF1}}/desactivar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "aplicar_desde": "{{hoy}}"
  }
}

tests {
  test("queda inactivo", function () {
    expect(res.status).to.equal(200);
    expect(res.body.activo).to.equal(false);
  });
}

docs {
  CU014: inactivar lleva la fecha desde la que aplica.
}
