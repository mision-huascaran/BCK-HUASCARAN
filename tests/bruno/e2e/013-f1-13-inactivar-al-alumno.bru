meta {
  name: F1-13 Inactivar al alumno
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/alumnos/{{idAlumnoF1}}/desactivar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("queda inactivo", function () {
    expect(res.status).to.equal(200);
    expect(res.body.activo).to.equal(false);
  });
}
