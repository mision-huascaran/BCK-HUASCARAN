meta {
  name: F5-13 Verificar el resultado de una operación
  type: http
  seq: 74
}

get {
  url: {{baseUrl}}/sincronizacion/operaciones/{{opB}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

tests {
  test("aceptada", function () { expect(res.status).to.equal(200); expect(res.body.estado).to.equal("aceptada"); });
}
