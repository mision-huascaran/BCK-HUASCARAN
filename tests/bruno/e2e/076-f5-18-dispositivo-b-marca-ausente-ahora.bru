meta {
  name: F5-18 Dispositivo B marca ausente (ahora)
  type: http
  seq: 76
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

body:json {
  {
    "fecha": "{{fechaClase}}",
    "registros": [{ "id_alumno": {{idAlumnoC}}, "estado": "ausente" }]
  }
}

tests {
  test("aplicada", function () {
    expect(res.status).to.equal(200);
    expect(res.body.registros[0].aplicado).to.equal(true);
    expect(res.body.registros[0].estado).to.equal('ausente');
  });
}
