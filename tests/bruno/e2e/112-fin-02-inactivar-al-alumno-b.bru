meta {
  name: FIN-02 Inactivar al alumno B
  type: http
  seq: 112
}

patch {
  url: {{baseUrl}}/alumnos/{{idAlumnoB}}/desactivar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

body:json {
  {
    "aplicar_desde": "{{hoy}}"
  }
}

tests {
  test("queda inactivo (o su clase de hoy ya lo tiene en la lista congelada)", function () {
    expect([200, 409]).to.include(res.status);
    if (res.status === 200) expect(res.body.activo).to.equal(false);
    else expect(res.body.motivo).to.equal('conflicto_listas_historicas');
  });
}
