meta {
  name: F5-09 Sincronizar: actividad iniciada sin conexión
  type: http
  seq: 67
}

post {
  url: {{baseUrl}}/actividades
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocenteB}}
}

body:json {
  {
    "id_actividad": "{{idActividadOffline}}",
    "inicio": "{{tInicioOffline}}",
    "id_sesion": "{{idSesionA}}"
  }
}

script:pre-request {
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  bru.setVar('idActividadOffline', uuid());
}

tests {
  test("201: queda en la sesión en que ocurrió, con su hora real", function () {
    expect(res.status).to.equal(201);
    expect(res.body.actividad.id_sesion).to.equal(bru.getVar('idSesionA'));
    expect(Date.parse(res.body.actividad.inicio)).to.equal(Date.parse(bru.getVar('tInicioOffline')));
    expect(res.body.actividad.estado).to.equal('en_curso');
  });
}

docs {
  CU009: una actividad iniciada sin conexión se registra en su sesión original al sincronizar.
}
