meta {
  name: F2-12 Editar al alumno A
  type: http
  seq: 32
}

patch {
  url: {{baseUrl}}/alumnos/{{idAlumnoA}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "apellidos": "Bruno F2 editado {{runId}}"
  }
}

tests {
  test("200 con el apellido nuevo", function () {
    expect(res.status).to.equal(200);
    expect(res.body.apellidos).to.equal('Bruno F2 editado ' + bru.getVar('runId'));
  });
}
