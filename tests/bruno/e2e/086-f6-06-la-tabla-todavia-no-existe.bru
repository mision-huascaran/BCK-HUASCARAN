meta {
  name: F6-06 La tabla todavía no existe
  type: http
  seq: 86
}

get {
  url: {{baseUrl}}/lectura/tablas?id_colegio={{idColegioDoc}}&id_programa={{idPrograma1}}&id_grado={{idGradoClase}}&id_seccion={{idSeccion}}&id_anio_escolar={{idAnio}}&mes={{mesClase}}&id_semana={{idSemana}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

tests {
  test("404 con la clase de referencia sugerida", function () {
    expect(res.status).to.equal(404);
    expect(res.body.motivo).to.equal('tabla_no_existe');
    expect(res.body.clase_referencia_sugerida.fecha).to.equal(bru.getVar('fechaClase'));
  });
}

docs {
  CU024: sin tabla, el sistema sugiere la clase habitual de la semana como referencia.
}
