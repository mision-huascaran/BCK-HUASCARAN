meta {
  name: F2-06 Matricular alumno A
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombres": "Alumno A",
    "apellidos": "Bruno F2 {{runId}}",
    "id_colegio": {{idColegioDoc}},
    "id_grado": {{idGradoDoc}},
    "id_programa": {{idProgramaDoc}}
  }
}

script:pre-request {
  if (!bru.getVar('runId')) bru.setVar('runId', String(Date.now()));
}

script:post-response {
  bru.setVar('idAlumnoA', res.body.id);
}

tests {
  test("201 en el aula del Docente", function () {
    expect(res.status).to.equal(201);
    expect(res.body.colegio.id).to.equal(bru.getVar('idColegioDoc'));
    expect(res.body.grado.id).to.equal(bru.getVar('idGradoDoc'));
  });
}

docs {
  CU014: el Docente crea alumnos solo en sus aulas y con una actividad iniciada.
}
