meta {
  name: F6-21 El Supervisor consulta la tabla
  type: http
  seq: 101
}

get {
  url: {{baseUrl}}/lectura/tablas?id_colegio={{idColegioDoc}}&id_programa={{idPrograma1}}&id_grado={{idGradoClase}}&id_seccion={{idSeccion}}&id_anio_escolar={{idAnio}}&mes={{mesClase}}&id_semana={{idSemana}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("solo lectura", function () {
    expect(res.status).to.equal(200);
    expect(res.body.escritura.permitida).to.equal(false);
  });
}
