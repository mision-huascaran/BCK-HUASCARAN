meta {
  name: F4-05 Registrar asistencia sin actividad
  type: http
  seq: 49
}

put {
  url: {{baseUrl}}/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "fecha": "{{fechaClase}}",
    "registros": [{ "id_alumno": {{idAlumnoCualquiera}}, "estado": "presente" }]
  }
}

tests {
  test("409 actividad_requerida", function () {
    expect(res.status).to.equal(409);
    expect(res.body.motivo).to.equal('actividad_requerida');
  });
}

docs {
  CU022: "Inicia una actividad de trabajo para habilitar el registro de datos."
}
