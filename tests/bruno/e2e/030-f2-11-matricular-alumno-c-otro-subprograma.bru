meta {
  name: F2-11 Matricular alumno C (otro subprograma)
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenDocente}}
}

body:json {
  {
    "nombres": "Alumno C",
    "apellidos": "Bruno {{runId}}",
    "id_colegio": {{idColegioDoc}},
    "id_grado": {{idGradoClase}},
    "id_seccion": {{idSeccion}},
    "id_programa": {{idPrograma2}},
    "pertenece_desde": "{{inicioPA}}"
  }
}

script:post-response {
  bru.setVar('idAlumnoC', res.body.id);
}

tests {
  test("201 en la sección de la corrida", function () {
    expect(res.status).to.equal(201);
    expect(res.body.seccion.id).to.equal(Number(bru.getVar('idSeccion')));
    expect(res.body.activo).to.equal(true);
  });
}
