meta {
  name: F5-03 Vuelve la conexión: nuevo inicio de sesión
  type: http
  seq: 64
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{correoDocente}}",
    "password": "{{passDocente}}"
  }
}

script:pre-request {
  // Las credenciales llegan por variables de entorno (Jenkins Credentials o la terminal);
  // nunca se guardan en el repo.
  const faltan = ['correoDocente', 'passDocente'].filter((k) => {
    const valor = bru.interpolate(bru.getEnvVar(k) || '');
    return !valor || valor.includes('{{');
  });
  if (faltan.length) {
    throw new Error('Faltan E2E_DOCENTE_USER / E2E_DOCENTE_PASS en el entorno (ver tests/bruno/README.md)');
  }
  if (!bru.getVar('runId')) bru.setVar('runId', String(Date.now()));

  // El nuevo login ocurre después de la caída: las horas de la cola ya pasaron en el servidor.
  const espera = Date.parse(bru.getVar('tCierreOffline')) + 1000 - Date.now();
  if (espera > 0) await new Promise((r) => setTimeout(r, espera));
}

script:post-response {
  bru.setVar('tokenDocenteB', res.body.access_token);
  const uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
  bru.setVar('idSesionB', res.body.sesion.id);
  bru.setVar('idActividadOffline', uuid());
  bru.setVar('opA', uuid());
  bru.setVar('opB', uuid());
}

tests {
  test("200 con token de 8 h", function () {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a('string');
    expect(res.body.usuario.rol).to.equal('Docente');
    const horas = (Date.parse(res.body.sesion.expira) - Date.parse(res.body.sesion.inicio)) / 3600e3;
    expect(horas).to.equal(8);
  });
}
