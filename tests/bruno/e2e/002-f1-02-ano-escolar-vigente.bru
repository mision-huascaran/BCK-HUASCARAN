meta {
  name: F1-02 Año escolar vigente
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/anios-escolares
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

script:pre-request {
  const hoyLima = () => new Date(Date.now() - 5 * 3600e3).toISOString().slice(0, 10);
  bru.setVar('hoy', hoyLima());
}

script:post-response {
  bru.setVar('idAnio', (res.body.find((a) => a.vigente) || res.body[res.body.length - 1]).id);
}

tests {
  test("hay un año escolar vigente", function () {
    expect(res.status).to.equal(200);
    expect(res.body.some((a) => a.vigente)).to.equal(true);
  });
}
