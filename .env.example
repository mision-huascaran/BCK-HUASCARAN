DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# true carga los usuarios de prueba al arrancar (development, qa, uat).
# En producción (main) debe ir en false.
CARGAR_DATOS_PRUEBA=true

# Entorno: dev, qa o uat. Da nombre al contenedor (<entorno>-bck-huascaran),
# que es como lo encuentra el proxy del servidor en la red proxy_net.
ENTORNO=dev

# Cuenta de Gmail dedicada al proyecto, usada para enviar la contraseña temporal
# a los profesores nuevos. Contraseña de aplicación (16 caracteres), no la clave real de Gmail.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Supervisor original (CU001). `python -m app.cli inicializar` lo crea en el primer
# arranque si no existe; si falta alguna variable, avisa en el log y lo omite.
# - PASSWORD: política de CU006 (8+ caracteres, mayúscula, minúscula, número y especial).
# - DNI: 8 dígitos.
# - Si la contraseña tiene "$", ponla entre comillas simples para que ni docker compose
#   ni python-dotenv la interpreten.
SUPERVISOR_ORIGINAL_CORREO=
SUPERVISOR_ORIGINAL_PASSWORD=
SUPERVISOR_ORIGINAL_NOMBRES=
SUPERVISOR_ORIGINAL_APELLIDOS=
SUPERVISOR_ORIGINAL_DNI=

# true SOLO para la primera carga de los colegios reales (app/datos/colegios_iniciales.json).
# Después vuelve a false: los colegios los administra la Supervisora desde la app
# (CU013) y una recarga podría duplicar un colegio que ya se renombró.
CARGAR_COLEGIOS_INICIALES=false

# Datos fijos para las pruebas E2E (Playwright) del frontend: `python -m app.cli inicializar`
# los crea o corrige en cada arranque (paso sembrar-e2e). Solo con SEED_E2E=true y ENTORNO
# en qa o dev: en uat, producción/piloto o con ENTORNO vacío se rechaza aunque esté en true.
# Las contraseñas cumplen la política de CU006; si falta una o no la cumple, esa cuenta no
# se crea (queda WARNING/ERROR en el log).
# Se leen del entorno del proceso, no de Settings: en Docker llegan por env_file; en local,
# fuera de Docker, expórtalas en la terminal y NO las pongas en el .env (Settings rechaza
# claves desconocidas del .env y la app no arrancaría).
SEED_E2E=false
E2E_DOCENTE_PASS=
E2E_SUPERVISOR_PASS=
E2E_DIRECTIVO_PASS=
E2E_INACTIVO_PASS=
