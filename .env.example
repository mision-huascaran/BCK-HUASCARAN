DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# true carga los usuarios de prueba al arrancar (development, qa, uat).
# En producción (main) debe ir en false.
CARGAR_DATOS_PRUEBA=true

# Entorno: dev, qa o uat. Da nombre al contenedor (<entorno>-bck-huascaran),
# que es como lo encuentra el proxy del servidor en la red proxy_net.
ENTORNO=dev
